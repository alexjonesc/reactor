{
    "makefile.configureOnOpen": false,

    // =========================================
    // CUSTOM GRUVBOX DARK HARD THEME OVERRIDES
    // Edit these values to customize your theme
    // =========================================

    // Gruvbox Color Palette Reference:
    // Background Hard: #1d2021 | Background: #282828 | Background Soft: #32302f
    // Foreground: #ebdbb2 | Foreground Dim: #a89984
    // Red: #fb4934 / #cc241d | Green: #b8bb26 / #98971a
    // Yellow: #fabd2f / #d79921 | Blue: #83a598 / #458588
    // Purple: #d3869b / #b16286 | Aqua: #8ec07c / #689d6a
    // Orange: #fe8019 / #d65d0e | Gray: #928374

    "workbench.colorCustomizations": {
        // Editor
        "editor.background": "#1d2021",
        "editor.foreground": "#ebdbb2",
        "editor.lineHighlightBackground": "#32302f",
        "editor.selectionBackground": "#504945",
        "editor.selectionHighlightBackground": "#665c5440",
        "editor.wordHighlightBackground": "#45858840",
        "editor.wordHighlightStrongBackground": "#689d6a40",
        "editor.findMatchBackground": "#fe801960",
        "editor.findMatchHighlightBackground": "#fabd2f40",
        "editorCursor.foreground": "#ebdbb2",
        "editorWhitespace.foreground": "#504945",
        "editorIndentGuide.background1": "#3c3836",
        "editorIndentGuide.activeBackground1": "#665c54",
        "editorLineNumber.foreground": "#665c54",
        "editorLineNumber.activeForeground": "#ebdbb2",

        // Editor Gutter
        "editorGutter.addedBackground": "#b8bb26",
        "editorGutter.modifiedBackground": "#83a598",
        "editorGutter.deletedBackground": "#fb4934",

        // Sidebar
        "sideBar.background": "#1d2021",
        "sideBar.foreground": "#ebdbb2",
        "sideBarTitle.foreground": "#ebdbb2",
        "sideBarSectionHeader.background": "#282828",
        "sideBarSectionHeader.foreground": "#ebdbb2",

        // Activity Bar
        "activityBar.background": "#1d2021",
        "activityBar.foreground": "#ebdbb2",
        "activityBar.inactiveForeground": "#928374",
        "activityBarBadge.background": "#d65d0e",
        "activityBarBadge.foreground": "#ebdbb2",

        // Title Bar
        "titleBar.activeBackground": "#1d2021",
        "titleBar.activeForeground": "#ebdbb2",
        "titleBar.inactiveBackground": "#1d2021",
        "titleBar.inactiveForeground": "#928374",

        // Status Bar
        "statusBar.background": "#1d2021",
        "statusBar.foreground": "#ebdbb2",
        "statusBar.debuggingBackground": "#fe8019",
        "statusBar.debuggingForeground": "#1d2021",
        "statusBar.noFolderBackground": "#1d2021",

        // Tabs
        "tab.activeBackground": "#32302f",
        "tab.activeForeground": "#ebdbb2",
        "tab.inactiveBackground": "#1d2021",
        "tab.inactiveForeground": "#a89984",
        "tab.border": "#1d2021",
        "tab.activeBorder": "#d65d0e",

        // Terminal
        "terminal.background": "#1d2021",
        "terminal.foreground": "#ebdbb2",
        "terminal.ansiBlack": "#1d2021",
        "terminal.ansiRed": "#e95646",
        "terminal.ansiGreen": "#b8bb26",
        "terminal.ansiYellow": "#fabd2f",
        "terminal.ansiBlue": "#83a598",
        "terminal.ansiMagenta": "#d3869b",
        "terminal.ansiCyan": "#8ec07c",
        "terminal.ansiWhite": "#ebdbb2",
        "terminal.ansiBrightBlack": "#928374",
        "terminal.ansiBrightRed": "#fb4934",
        "terminal.ansiBrightGreen": "#b8bb26",
        "terminal.ansiBrightYellow": "#fabd2f",
        "terminal.ansiBrightBlue": "#83a598",
        "terminal.ansiBrightMagenta": "#d3869b",
        "terminal.ansiBrightCyan": "#8ec07c",
        "terminal.ansiBrightWhite": "#ebdbb2",

        // Input
        "input.background": "#282828",
        "input.foreground": "#ebdbb2",
        "input.border": "#504945",
        "input.placeholderForeground": "#928374",

        // Dropdown
        "dropdown.background": "#282828",
        "dropdown.foreground": "#ebdbb2",
        "dropdown.border": "#504945",

        // Lists
        "list.activeSelectionBackground": "#504945",
        "list.activeSelectionForeground": "#ebdbb2",
        "list.hoverBackground": "#32302f",
        "list.inactiveSelectionBackground": "#3c3836",
        "list.highlightForeground": "#fe8019",

        // Git Decorations
        "gitDecoration.addedResourceForeground": "#b8bb26",
        "gitDecoration.modifiedResourceForeground": "#83a598",
        "gitDecoration.deletedResourceForeground": "#fb4934",
        "gitDecoration.untrackedResourceForeground": "#8ec07c",
        "gitDecoration.ignoredResourceForeground": "#665c54",
        "gitDecoration.conflictingResourceForeground": "#d3869b",

        // Scrollbar
        "scrollbar.shadow": "#00000000",
        "scrollbarSlider.background": "#50494580",
        "scrollbarSlider.hoverBackground": "#665c54",
        "scrollbarSlider.activeBackground": "#7c6f64",

        // Bracket Matching
        "editorBracketMatch.background": "#92837440",
        "editorBracketMatch.border": "#928374",

        // Peek View
        "peekView.border": "#504945",
        "peekViewEditor.background": "#282828",
        "peekViewResult.background": "#1d2021",
        "peekViewTitle.background": "#282828"
    },

    "editor.tokenColorCustomizations": {
        // Syntax Highlighting
        "comments": "#928374",
        "strings": "#b8bb26",
        "keywords": "#fb4934",
        "numbers": "#d3869b",
        "types": "#fabd2f",
        "functions": "#8ec07c",
        "variables": "#ebdbb2",

        "textMateRules": [
            // Comments
            {
                "scope": ["comment", "punctuation.definition.comment"],
                "settings": { "foreground": "#5f544a", "fontStyle": "italic" }
            },
            // Strings
            {
                "scope": ["string", "string.quoted"],
                "settings": { "foreground": "#bfbb5a" }
            },
            // Keywords
            {
                "scope": ["keyword", "keyword.control", "keyword.operator.new"],
                "settings": { "foreground": "#f66050" }
            },
            // Operators
            {
                "scope": ["keyword.operator", "punctuation"],
                "settings": { "foreground": "#ebdbb2" }
            },
            // Functions
            {
                "scope": ["entity.name.function", "support.function", "meta.function-call"],
                "settings": { "foreground": "#8ec07c" }
            },
            // Types / Classes
            {
                "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
                "settings": { "foreground": "#e1ab2e" }
            },
            // Variables
            {
                "scope": ["variable", "variable.other"],
                "settings": { "foreground": "#dbc99c" }
            },
            // Parameters
            {
                "scope": ["variable.parameter"],
                "settings": { "foreground": "#83a598" }
            },
            // Constants
            {
                "scope": ["constant", "constant.numeric", "constant.language"],
                "settings": { "foreground": "#d3869b" }
            },
            // Storage (var, let, const, func, etc.)
            {
                "scope": ["storage", "storage.type", "storage.modifier"],
                "settings": { "foreground": "#e95544" }
            },
            // Go-specific: Package names
            {
                "scope": ["entity.name.package.go"],
                "settings": { "foreground": "#8ec07c" }
            },
            // Go-specific: Imports
            {
                "scope": ["entity.name.import.go"],
                "settings": { "foreground": "#b8bb26" }
            },
            // Go-specific: Struct fields
            {
                "scope": ["variable.other.member.go"],
                "settings": { "foreground": "#83a598" }
            },
            // Tags (HTML, XML, JSX)
            {
                "scope": ["entity.name.tag"],
                "settings": { "foreground": "#fb4934" }
            },
            // Attributes
            {
                "scope": ["entity.other.attribute-name"],
                "settings": { "foreground": "#fabd2f" }
            },
            // JSON Keys
            {
                "scope": ["support.type.property-name.json"],
                "settings": { "foreground": "#83a598" }
            },
            // Markdown Headings
            {
                "scope": ["markup.heading", "entity.name.section.markdown"],
                "settings": { "foreground": "#b8bb26", "fontStyle": "bold" }
            },
            // Markdown Bold
            {
                "scope": ["markup.bold"],
                "settings": { "foreground": "#fe8019", "fontStyle": "bold" }
            },
            // Markdown Italic
            {
                "scope": ["markup.italic"],
                "settings": { "foreground": "#fabd2f", "fontStyle": "italic" }
            },
            // Markdown Links
            {
                "scope": ["markup.underline.link"],
                "settings": { "foreground": "#83a598" }
            }
        ]
    }
}